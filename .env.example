# ==============================================================================
# Lean Client Onboarding System — Environment Configuration
# ==============================================================================
# Copy this file to .env and configure credentials before deploying workflows.
# Never commit actual secret keys or API tokens to version control.
# ==============================================================================

# --- DocuSeal E-Signature API ---
# Generated from DocuSeal Settings -> API Keys (Outbound REST only)
DOCUSEAL_API_KEY=your-docuseal-api-key
DOCUSEAL_TEMPLATE_ID=120491

# --- Stripe Invoicing & Payments ---
# Restricted key with permissions: Customers (Read/Write), Invoices (Read/Write)
STRIPE_API_KEY=your-stripe-restricted-key
# Webhook signing secret from Stripe Dashboard -> Webhooks -> Add endpoint (/webhook/stripe-paid)
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- Canonical Database (Airtable or Notion) ---
# Airtable Personal Access Token (PAT) with data.records:read and data.records:write
# OR Notion Internal Integration Secret (secret_...)
DATABASE_API_TOKEN=your-database-api-token
DATABASE_BASE_OR_DB_ID=your-database-base-or-db-id

# --- Notion Client Portals ---
# Internal integration token with page creation capabilities
NOTION_INTEGRATION_TOKEN=your-notion-integration-token
# Parent page ID under which client portal pages are dynamically provisioned
NOTION_PARENT_PORTALS_PAGE_ID=your-notion-parent-portal-page-id

# --- Google Drive File Storage ---
# OAuth2 client credentials or Service Account JSON for folder provisioning
GOOGLE_OAUTH_CREDENTIALS={"client_id":"your-client-id.apps.googleusercontent.com","client_secret":"your-client-secret"}
GOOGLE_DRIVE_PARENT_FOLDER_ID=your-drive-parent-folder-id

# --- Owner Mailbox (Welcome Email Dispatch) ---
# Direct mailbox settings for personal client outreach
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=consultant@example.com
SMTP_PASS=your-app-password
OWNER_EMAIL=consultant@example.com
OWNER_NAME=Jane Consultant
OWNER_TITLE=Principal Automation Architect
OWNER_COMPANY=Acme Automation Studio

# --- Client Links & Kickoff Scheduling ---
BOOKING_LINK=https://cal.com/consultant/kickoff-45m
PASSWORD_MANAGER_LINK=https://1password.com/share

# --- Reminder Thresholds (WF-03) ---
REMINDER_UNSIGNED_DAYS=3
REMINDER_UNPAID_DAYS=7

# --- Independent Operational Alerting (Telegram / Slack) ---
# Telegram Bot Token & Chat ID for out-of-band failure and digest alerts
ALERT_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
ALERT_TELEGRAM_CHAT_ID=-1001234567890
# Alternative: Slack Incoming Webhook URL
# ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXXX
